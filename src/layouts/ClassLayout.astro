---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export interface Props {
  courseId: string;
  classId: string;
  currentPath: string;
}

const { courseId, classId, currentPath } = Astro.props;

const allClasses = await getCollection('classes');
const courses = await getCollection('courses');
const course = courses.find((c) => c.id === courseId);
const classEntry = allClasses.find((c) => c.id === classId && c.data.course === courseId);

if (!course || !classEntry) {
  return Astro.redirect('/404');
}

const { Content } = await render(classEntry);
const sorted = allClasses.filter((c) => c.data.course === courseId).sort((a, b) => a.data.order - b.data.order);
const idx = sorted.findIndex((c) => c.id === classId);
const prevClass = idx > 0 ? sorted[idx - 1] : null;
const nextClass = idx < sorted.length - 1 ? sorted[idx + 1] : null;
const classNum = idx + 1;
---

<BaseLayout title={`${classEntry.data.title} - ${course.data.title} - Ecoudea`} description={classEntry.data.description}>
  <Fragment slot="header">
    <Navbar currentPath={currentPath} />
  </Fragment>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <nav class="flex items-center gap-2 text-sm text-text-muted mb-6 flex-wrap">
      <a href="/" class="hover:text-accent transition-colors no-underline">Inicio</a>
      <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      <a href={`/cursos/${courseId}`} class="hover:text-accent transition-colors no-underline truncate max-w-[200px]">{course.data.title}</a>
      <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      <span class="text-text truncate max-w-[200px]">{classEntry.data.title}</span>
    </nav>

    <div class="flex items-center gap-3 mb-6">
      <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-accent-soft text-accent font-bold text-sm border border-accent/30">
        {classNum}
      </span>
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-text">{classEntry.data.title}</h1>
        {classEntry.data.description && (
          <p class="text-sm text-text-muted mt-1">{classEntry.data.description}</p>
        )}
      </div>
    </div>

    <div class="lg:flex lg:gap-8">
      <article class="prose-class flex-1 min-w-0">
        <Content />
      </article>
    </div>

    <div class="mt-10 flex items-center justify-between gap-4 pt-6 border-t border-border-subtle">
      {prevClass ? (
        <a href={`/cursos/${courseId}/${prevClass.id}`} class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-border-subtle text-sm font-medium text-text hover:border-accent/50 hover:text-accent transition-all no-underline card-hover">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
          <span class="hidden sm:inline truncate max-w-[200px]">{prevClass.data.title}</span>
          <span class="sm:hidden">Anterior</span>
        </a>
      ) : <div />}
      {nextClass ? (
        <a href={`/cursos/${courseId}/${nextClass.id}`} class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-border-subtle text-sm font-medium text-text hover:border-accent/50 hover:text-accent transition-all no-underline card-hover">
          <span class="hidden sm:inline truncate max-w-[200px]">{nextClass.data.title}</span>
          <span class="sm:hidden">Siguiente</span>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      ) : <div />}
    </div>
  </div>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
