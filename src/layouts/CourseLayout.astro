---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

export interface Props {
  courseId: string;
  currentPath: string;
}

const { courseId, currentPath } = Astro.props;

const courses = await getCollection('courses');
const allClasses = await getCollection('classes');

const course = courses.find((c) => c.id === courseId);
const sortedClasses = allClasses.filter((c) => c.data.course === courseId).sort((a, b) => a.data.order - b.data.order);

if (!course) {
  return Astro.redirect('/404');
}

const typeColors: Record<string, string> = {
  clase: 'border-accent text-accent bg-accent-soft',
  practica: 'border-rose-500 text-rose-400 bg-rose-500/10',
  presentacion: 'border-gray-500 text-gray-400 bg-gray-500/10',
  guia: 'border-amber-500 text-amber-400 bg-amber-500/10',
};
const typeLabels: Record<string, string> = {
  clase: 'Clase',
  practica: 'Práctica',
  presentacion: 'Presentación',
  guia: 'Guía',
};
---

<BaseLayout title={`${course.data.title} - Ecoudea`} description={course.data.description}>
  <Fragment slot="header">
    <Navbar currentPath={currentPath} />
  </Fragment>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="flex flex-col sm:flex-row items-start gap-6 sm:gap-8">
      {
        course.data.image && (
          <div class="w-full sm:w-64 shrink-0 rounded-xl overflow-hidden border border-border-subtle">
            <img src={course.data.image} alt={course.data.title} class="w-full h-48 sm:h-40 object-cover" loading="lazy" />
          </div>
        )
      }
      <div class="flex-1 min-w-0">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-accent-soft text-accent border border-accent/30 mb-3">
          {course.data.category}
        </span>
        <h1 class="text-2xl sm:text-3xl font-bold text-text mb-2">{course.data.title}</h1>
        <p class="text-text-muted text-base leading-relaxed">{course.data.description}</p>
        <div class="flex items-center gap-3 mt-4 text-sm text-text-muted">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
            {sortedClasses.length} clases
          </span>
        </div>
      </div>
    </div>

    <hr class="my-8 border-none h-px bg-gradient-to-r from-transparent via-accent/30 to-transparent" />

    <div class="space-y-2">
      {sortedClasses.map((entry, i) => {
        const typeStyle = typeColors[entry.data.classType] || typeColors.clase;
        const typeLabel = typeLabels[entry.data.classType] || 'Clase';
        return (
          <a
            href={`/cursos/${courseId}/${entry.id}`}
            class:list={[
              'flex items-center gap-3 sm:gap-4 p-3 sm:p-4 rounded-xl border border-border-subtle no-underline',
              'card-hover hover-glow',
              'fade-in-up',
            ].join(' ')}
            style={`animation-delay: ${i * 0.03}s`}
          >
            <span class={`shrink-0 w-8 h-8 sm:w-10 sm:h-10 rounded-lg border ${typeStyle} flex items-center justify-center text-xs sm:text-sm font-bold`}>
              {i + 1}
            </span>
            <div class="flex-1 min-w-0">
              <h3 class="text-sm sm:text-base font-semibold text-text truncate">{entry.data.title}</h3>
              {entry.data.description && (
                <p class="text-xs sm:text-sm text-text-muted mt-0.5 line-clamp-1">{entry.data.description}</p>
              )}
            </div>
            <span class="shrink-0 text-[10px] sm:text-xs font-medium px-2 py-1 rounded-md bg-white/5 text-text-muted border border-border-subtle">
              {typeLabel}
            </span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        );
      })}
    </div>
  </div>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
