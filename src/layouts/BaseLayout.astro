---
import '../styles/global.css';
import FloatingButtons from '../components/FloatingButtons.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  showTools?: boolean;
  /** Carga KaTeX (CSS+JS+enhance) — solo necesario en páginas con fórmulas */
  math?: boolean;
  /** Schema JSON-LD adicional (p. ej. Course) */
  jsonLd?: string;
  /** Carga el helper de desbloqueo progresivo (páginas de curso/clase) */
  unlock?: boolean;
  /** Evita que buscadores indexen la página (panel admin) */
  noindex?: boolean;
}

const {
  title = 'Ecoudea',
  description = 'Cursos y herramientas de estadística',
  image,
  showTools = false,
  math = false,
  jsonLd,
  unlock = false,
  noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = Astro.url;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="description" content={description} />
    <meta name="keywords" content="estadística, R, Python, cursos, programación, probabilidad" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ecoudea" />
    <meta property="og:locale" content="es_CO" />
    {image && <meta property="og:image" content={image} />}
    {!image && <meta property="og:image" content={`${base}/assets/images/logo-ecoudea.png`} />}
    <meta name="twitter:card" content="summary" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0a0f1a" />
    <meta name="astro-base" content={base} />
    <title>{title}</title>
    <script>document.documentElement.classList.add('js')</script>
    {math && <link rel="stylesheet" href={`${base}/assets/css/katex.min.css`} />}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd}></script>}
  </head>
  <body class="flex flex-col min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-accent focus:text-white focus:text-sm no-underline">
      Saltar al contenido
    </a>
    <slot name="header" />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <slot name="footer" />
    {showTools && <FloatingButtons />}

    <script defer src={`${base}/assets/js/animations.js`}></script>
    {unlock && <script defer src={`${base}/assets/js/unlock.js`}></script>}
    {math && <script defer src={`${base}/assets/js/katex.min.js`}></script>}
    {math && <script defer src={`${base}/assets/js/auto-render.min.js`}></script>}
    {math && <script defer src={`${base}/assets/js/enhance.js`}></script>}
  </body>
</html>
