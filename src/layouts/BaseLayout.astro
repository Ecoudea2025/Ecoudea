---
import '../styles/global.css';
import FloatingButtons from '../components/FloatingButtons.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  showTools?: boolean;
}

const { title = 'Ecoudea', description = 'Cursos y herramientas de estadística', image, showTools = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="description" content={description} />
    <meta name="keywords" content="estadística, R, Python, cursos, programación, probabilidad" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0f1a" />
    <title>{title}</title>
    <link rel="stylesheet" href={`${base}/assets/css/katex.min.css`} />
  </head>
  <body class="flex flex-col min-h-screen">
    <slot name="header" />
    <main class="flex-1">
      <slot />
    </main>
    <slot name="footer" />
    {showTools && <FloatingButtons />}

    <script defer src={`${base}/assets/js/katex.min.js`}></script>
    <script defer src={`${base}/assets/js/auto-render.min.js`}></script>
    <script defer src={`${base}/assets/js/enhance.js`}></script>
  </body>
</html>
