---
import '../styles/global.css';
import FloatingButtons from '../components/FloatingButtons.astro';
import { url } from '../lib/url';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  showTools?: boolean;
  /** Carga enhance.js (TOC, botones Show/Hide, imágenes) — páginas de contenido */
  enhance?: boolean;
  /** Schema JSON-LD adicional (p. ej. Course) */
  jsonLd?: string;
  /** Evita que buscadores indexen la página (panel admin) */
  noindex?: boolean;
}

const {
  title = 'Ecoudea',
  description = 'Cursos de economía, estadística y programación',
  image,
  showTools = false,
  enhance = false,
  jsonLd,
  noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = Astro.url;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url(`/favicon.svg`)} />
    <meta name="description" content={description} />
    <meta name="keywords" content="estadística, R, Python, cursos, programación, probabilidad" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ecoudea" />
    <meta property="og:locale" content="es_CO" />
    {image && <meta property="og:image" content={image} />}
    {!image && <meta property="og:image" content={url(`/assets/images/logo-ecoudea.png`)} />}
    <meta name="twitter:card" content="summary" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0a0f1a" />
    <meta name="astro-base" content={base} />
    <title>{title}</title>
    <script is:inline>
      // Tema antes del primer paint (anti-FOUC). Ausencia de data-theme = sistema.
      try {
        const t = localStorage.getItem('ecoudea-theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        else document.documentElement.removeAttribute('data-theme');
      } catch (e) {}
    </script>
    <script>document.documentElement.classList.add('js')</script>
    {jsonLd && <script type="application/ld+json" set:html={jsonLd}></script>}
  </head>
  <body class="flex flex-col min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-accent focus:text-white focus:text-sm no-underline">
      Saltar al contenido
    </a>
    <slot name="header" />
    <main id="main" class="flex-1" data-pagefind-body>
      <slot />
    </main>
    <slot name="footer" />
    {showTools && <FloatingButtons />}

    <script defer src={url(`/assets/js/animations.js`)}></script>
    {enhance && <script defer src={url(`/assets/js/enhance.js`)}></script>}
    <script is:inline>
      if('serviceWorker' in navigator&&(location.protocol==='https:'||location.hostname==='localhost')){const b=document.querySelector('meta[name="astro-base"]')?.content||'';navigator.serviceWorker.register(b+'/sw.js',{scope:b+'/'}).catch(()=>{})}
    </script>
    <script is:inline>
      (function () {
        var REDUCE = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function scrollToEl(el) {
          var y = el.getBoundingClientRect().top + window.scrollY - 120;
          window.scrollTo({ top: Math.max(0, y), behavior: REDUCE ? 'auto' : 'smooth' });
        }
        function flash(el) {
          el.classList.add('flash-target');
          setTimeout(function () { el.classList.remove('flash-target'); }, 2600);
        }
        function escRe(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
        // "frontera" también casa "fronterá": cada vocal/ñ expande a su clase con tildes.
        function accentRe(q) {
          var map = { a: 'aáàäâ', A: 'AÁÀÄÂ', e: 'eéèëê', E: 'EÉÈËÊ', i: 'iíìïî', I: 'IÍÌÏÎ', o: 'oóòöô', O: 'OÓÒÖÔ', u: 'uúùüû', U: 'UÚÙÜÛ', n: 'nñ', N: 'NÑ', c: 'cç', C: 'CÇ' };
          var out = '';
          for (var k = 0; k < q.length; k++) out += map[q[k]] ? '[' + map[q[k]] + ']' : escRe(q[k]);
          return new RegExp(out, 'i');
        }
        var SKIP = 'script,style,noscript,pre,code,textarea,.katex,.katex-display,.copy-tex-btn';
        function findWord(q) {
          var re = accentRe(q);
          // 1.º dentro del artículo (evita marcar chrome: miga de pan, hero, botones).
          var scopes = [document.querySelector('article.prose-class'), document.getElementById('main'), document.body];
          for (var s = 0; s < scopes.length; s++) {
            var root = scopes[s];
            if (!root) continue;
            var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
            var node;
            while ((node = walker.nextNode())) {
              var t = node.nodeValue;
              if (!t || t.length > 2000) continue;
              var m = re.exec(t);
              if (!m) continue;
              var p = node.parentElement;
              if (p && p.closest && p.closest(SKIP)) continue;
              return { node: node, index: m.index, len: m[0].length };
            }
          }
          return null;
        }
        function go() {
          var q = null;
          try { q = new URLSearchParams(location.search).get('q'); } catch (e) { q = null; }
          if (q && q.trim()) {
            // Consumir ?q= una sola vez: así los clics posteriores (TOC, hashes)
            // navegan al ancla sin que la palabra vuelva a secuestrar el scroll.
            try {
              var clean = location.pathname + location.hash;
              history.replaceState(null, '', clean);
            } catch (e2) {}
            var hit = findWord(q.trim().slice(0, 80));
            if (hit) {
              requestAnimationFrame(function () {
                var node = hit.node;
                var after = node.splitText(hit.index);
                after.splitText(hit.len);
                var mark = document.createElement('mark');
                mark.className = 'search-hit flash-target';
                mark.textContent = after.nodeValue;
                after.parentNode.replaceChild(mark, after);
                scrollToEl(mark);
                flash(mark);
                setTimeout(function () {
                  if (!mark.parentNode) return;
                  mark.parentNode.replaceChild(document.createTextNode(mark.textContent), mark);
                }, 2800);
              });
              return;
            }
            // Palabra no hallada en el texto: degradar al ancla si existe.
          }
          var h = location.hash;
          if (!h || h.length < 2) return;
          var el = null;
          try { el = document.getElementById(decodeURIComponent(h.slice(1))); } catch (e) { el = document.getElementById(h.slice(1)); }
          if (!el) return;
          requestAnimationFrame(function () {
            scrollToEl(el);
            flash(el);
          });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
        else setTimeout(go, 0);
        window.addEventListener('hashchange', go);
      })();
    </script>
  </body>
</html>
