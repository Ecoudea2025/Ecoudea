---
export interface Props {
  id: string;
  title?: string;
}

const { id, title = 'Mostrar contenido' } = Astro.props;
---

<div class="accordion-item border border-border-subtle rounded-xl overflow-hidden bg-elevated/50 mb-3">
  <button
    class="accordion-trigger w-full flex items-center justify-between gap-3 px-4 py-3 text-sm font-medium text-text hover:bg-white/5 transition-colors cursor-pointer"
    data-accordion={id}
    aria-expanded="false"
  >
    <span class="flex items-center gap-2">
      <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{title}</span>
    </span>
    <svg class="accordion-chevron w-4 h-4 text-text-muted transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>
  <div class="accordion-content max-h-0 overflow-hidden transition-all duration-300" data-accordion-content={id}>
    <div class="px-4 pb-4">
      <slot />
    </div>
  </div>
</div>

<script>
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.accordion-trigger');
    if (!btn) return;
    const id = btn.dataset.accordion;
    const content = document.querySelector(`[data-accordion-content="${id}"]`);
    const chevron = btn.querySelector('.accordion-chevron');
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', !isOpen);
    if (isOpen) {
      content.style.maxHeight = '0';
      chevron.style.transform = 'rotate(0deg)';
    } else {
      content.style.maxHeight = content.scrollHeight + 'px';
      chevron.style.transform = 'rotate(180deg)';
    }
  });
</script>
