---
// Selector claro / oscuro / sistema. Persiste en localStorage['ecoudea-theme'].
// El tema efectivo se aplica en <html data-theme> (ausente = sistema).
---

<button
  id="theme-toggle"
  type="button"
  class="flex items-center justify-center w-11 h-11 rounded-lg text-text-muted hover:text-text hover:bg-white/5 transition-all no-underline border-0 bg-transparent cursor-pointer"
  aria-label="Cambiar tema de color"
  title="Cambiar tema: claro / oscuro / sistema"
>
  <svg id="theme-icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <svg id="theme-icon-moon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
  <svg id="theme-icon-system" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
  </svg>
  <span id="theme-label" class="sr-only">Tema: sistema</span>
</button>

<script is:inline>
  (() => {
    const KEY = 'ecoudea-theme';
    const DARK_META = '#0a0f1a';
    const LIGHT_META = '#faf8f1';
    const order = ['system', 'light', 'dark'];
    const labels = { system: 'sistema', light: 'claro', dark: 'oscuro' };

    function stored() {
      try {
        const v = localStorage.getItem(KEY);
        return order.includes(v) ? v : 'system';
      } catch (e) { return 'system'; }
    }
    function effective(v) {
      if (v === 'system') {
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      }
      return v;
    }
    function paint(v) {
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      ['sun', 'moon', 'system'].forEach((k) => {
        document.getElementById('theme-icon-' + k)?.classList.add('hidden');
      });
      const icon = v === 'system' ? 'system' : v === 'light' ? 'sun' : 'moon';
      document.getElementById('theme-icon-' + icon)?.classList.remove('hidden');
      const label = document.getElementById('theme-label');
      if (label) label.textContent = 'Tema: ' + labels[v] + ' (clic para cambiar)';
      btn.setAttribute('aria-label', 'Tema actual: ' + labels[v] + '. Activar para cambiar.');
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', effective(v) === 'light' ? LIGHT_META : DARK_META);
    }
    function apply(v) {
      if (v === 'system') document.documentElement.removeAttribute('data-theme');
      else document.documentElement.setAttribute('data-theme', v);
      paint(v);
    }
    function init() {
      const btn = document.getElementById('theme-toggle');
      if (!btn || btn.dataset.themeReady) return;
      btn.dataset.themeReady = '1';
      apply(stored());
      btn.addEventListener('click', () => {
        const next = order[(order.indexOf(stored()) + 1) % order.length];
        try { localStorage.setItem(KEY, next); } catch (e) {}
        apply(next);
      });
      window.matchMedia('(prefers-color-scheme: light)').addEventListener?.('change', () => paint(stored()));
      document.addEventListener('astro:after-swap', () => apply(stored()));
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
