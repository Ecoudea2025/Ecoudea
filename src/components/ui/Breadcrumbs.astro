---
export interface Props {
  items: Array<{ label: string; href?: string }>;
}
const { items } = Astro.props;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.label,
    ...(it.href ? { item: it.href } : {}),
  })),
});
---
<nav aria-label="Miga de pan" class="flex items-center gap-2 text-sm text-text-muted mb-6 flex-wrap">
  {items.map((it, i) => (
    <>
      {i > 0 && (
        <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      )}
      {it.href ? (
        <a href={it.href} class="hover:text-accent transition-colors no-underline truncate max-w-[180px] sm:max-w-[300px]">{it.label}</a>
      ) : (
        <span aria-current="page" class="text-text truncate max-w-[180px] sm:max-w-[300px]">{it.label}</span>
      )}
    </>
  ))}
</nav>
<script type="application/ld+json" set:html={jsonLd} />
