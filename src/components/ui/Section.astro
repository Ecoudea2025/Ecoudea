---
export interface Props {
  id?: string;
  /** Ancho máximo del contenedor */
  width?: 'narrow' | 'default' | 'wide';
  /** Espaciado vertical */
  pad?: 'sm' | 'md' | 'lg';
  labelledby?: string;
}
const { id, width = 'default', labelledby } = Astro.props;
const max = { narrow: 'max-w-4xl', default: 'max-w-6xl', wide: 'max-w-7xl' }[width];
const pad = { sm: 'py-10 sm:py-12', md: 'py-16 sm:py-20', lg: 'py-20 sm:py-28' }[Astro.props.pad ?? 'md'];
---
<section id={id} aria-labelledby={labelledby} class="relative">
  <div class={`${max} mx-auto px-4 sm:px-6 lg:px-8 ${pad}`}>
    <slot />
  </div>
</section>
