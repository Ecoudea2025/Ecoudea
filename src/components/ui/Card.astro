---
export interface Props {
  variant?: 'default' | 'outline' | 'ghost';
  href?: string;
  class?: string;
}
const { variant = 'default', href, class: cls = '' } = Astro.props;
const baseCls = 'rounded-2xl border border-border-subtle card-hover';
const variants = {
  default: 'bg-elevated/60 p-6 sm:p-8',
  outline: 'bg-transparent p-6 sm:p-8',
  ghost: 'bg-surface p-4 sm:p-5',
};
const Tag = href ? 'a' : 'div';
---
<Tag href={href} class={`${baseCls} ${variants[variant]} ${cls} ${href ? 'no-underline block' : ''}`}>
  <slot />
</Tag>
