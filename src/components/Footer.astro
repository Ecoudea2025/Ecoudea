---
const base = import.meta.env.BASE_URL;
---

<footer class="border-t border-border-subtle mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="flex items-center justify-center w-6 h-6 rounded gradient-bg border border-accent/20">
          <span class="text-xs font-bold gradient-text">E</span>
        </span>
        <span class="text-sm font-semibold gradient-text">Ecoudea</span>
      </div>
      <div class="flex items-center gap-4 text-sm text-text-muted">
        <a href={`${base}/acercade`} class="hover:text-accent transition-colors no-underline">Acerca de</a>
        <span class="text-border-subtle">|</span>
        <span class="text-xs">Astro + Tailwind</span>
      </div>
    </div>
    <div class="mt-4 text-center text-[10px] text-text-muted/40">
      &copy; {new Date().getFullYear()} Ecoudea
    </div>
  </div>
</footer>
