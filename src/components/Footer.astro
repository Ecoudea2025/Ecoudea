---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const courses = await getCollection('courses');
const allClasses = await getCollection('classes');
const sortedCourses = courses.sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const totalClasses = allClasses.length;
---

<footer class="border-t border-border-subtle mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="lg:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg gradient-bg border border-accent/20">
            <img src={`${base}/assets/images/logo-ecoudea.png`} alt="Ecoudea" class="w-6 h-6 rounded-md object-cover" />
          </span>
          <span class="text-lg font-bold gradient-text">Ecoudea</span>
        </div>
        <p class="text-sm text-text-muted max-w-sm leading-relaxed">
          Cursos abiertos de estadística, probabilidad y programación con R y Python.
          Material organizado, prácticas guiadas y teoría explicada paso a paso.
        </p>
        <p class="text-xs text-text-muted/60">
          {totalClasses} clases · {courses.length} cursos disponibles
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-text mb-3 uppercase tracking-wide">Explorar</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}/`} class="text-text-muted hover:text-accent transition-colors no-underline">Inicio</a></li>
          <li><a href={`${base}/acercade`} class="text-text-muted hover:text-accent transition-colors no-underline">Acerca de</a></li>
          <li><a href={`${base}/#directorio`} class="text-text-muted hover:text-accent transition-colors no-underline">Directorio de cursos</a></li>
          <li><a href={`${base}/tablero-latex`} class="text-text-muted hover:text-accent transition-colors no-underline">Tablero LaTeX</a></li>
          <li>
            <a href="https://github.com/Ecoudea2025/Ecoudea" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-text-muted hover:text-accent transition-colors no-underline">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
              Repositorio
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-text mb-3 uppercase tracking-wide">Cursos</h3>
        <ul class="space-y-2 text-sm">
          {sortedCourses.map((course) => (
            <li>
              <a href={`${base}/cursos/${course.id}`} class="text-text-muted hover:text-accent transition-colors no-underline">
                {course.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-border-subtle flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="text-center text-xs text-text-muted/60">
        &copy; {new Date().getFullYear()} Ecoudea · Material educativo abierto ·
        contenido original de
        <a href="https://github.com/jiperezga" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-accent underline decoration-dotted">Jorge Iván Pérez</a>
      </div>
      <div class="flex items-center gap-2 text-xs text-text-muted/60">
        <span class="hidden sm:inline">Hecho con</span>
        <span class="font-mono text-accent/70">Astro + Tailwind</span>
      </div>
    </div>
  </div>
</footer>
