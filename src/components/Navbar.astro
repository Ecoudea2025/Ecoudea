---
export interface Props {
  currentPath?: string;
}

import ThemeToggle from './ThemeToggle.astro';
import SearchModal from './SearchModal.astro';
import { url } from '../lib/url';

const { currentPath = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const github = 'https://github.com/Ecoudea2025/Ecoudea';
const navLinks = [
  { href: url('/'), label: 'Inicio', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { href: url('/#directorio'), label: 'Cursos', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
  { href: url('/tablero-latex'), label: 'LaTeX', icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4' },
  { href: url('/acercade'), label: 'Acerca de', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
];
const categories = [
  { label: 'Cursos', filter: 'Cursos' },
];
---

<nav class="sticky top-0 z-50 border-b border-border-subtle nav-shell" aria-label="Navegación principal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 sm:h-16">
      <a href={url(`/`)} class="flex items-center gap-3 font-bold text-lg sm:text-xl text-text no-underline group" aria-current={currentPath === url('/') ? 'page' : undefined}>
        <span class="relative block w-10 h-10 sm:w-11 sm:h-11 rounded-xl overflow-hidden border border-accent/30 shadow-lg shadow-accent/10 shrink-0" data-logo-anim>
          <svg viewBox="0 0 64 64" class="w-full h-full block" role="img" aria-label="Ecoudea">
            <defs>
              <linearGradient id="logoLiveBg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#65a30d" />
                <stop offset="1" stop-color="#0e7774" />
              </linearGradient>
              <linearGradient id="logoLiveShine" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#fff" stop-opacity="0" />
                <stop offset="0.5" stop-color="#fff" stop-opacity="0.5" />
                <stop offset="1" stop-color="#fff" stop-opacity="0" />
              </linearGradient>
              <clipPath id="logoLiveClip"><rect x="2" y="2" width="60" height="60" rx="16" /></clipPath>
            </defs>
            <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#logoLiveBg)" />
            <!-- E gruesa: primero trazo, luego relleno -->
            <g fill="none" stroke-linecap="round" stroke-width="5.5">
              <path d="M25 20 V44" stroke="#ffffff" pathLength="100" class="la-draw la-spine" />
              <path d="M25 23 H43" stroke="#ffffff" pathLength="100" class="la-draw la-arm" />
              <path d="M25 32 H36" stroke="#fcd34d" pathLength="100" class="la-draw la-arm" />
              <path d="M25 41 H43" stroke="#ffffff" pathLength="100" class="la-draw la-arm" />
            </g>
            <g fill="#ffffff" class="la-fill" opacity="0">
              <rect x="22" y="19" width="6" height="26" rx="2.5" />
              <rect x="22" y="20.5" width="21" height="5" rx="2.5" />
              <rect x="22" y="29.5" width="14" height="5" rx="2.5" />
              <rect x="22" y="38.5" width="21" height="5" rx="2.5" />
            </g>
            <!-- Motivo marca: ejes + oferta/demanda + equilibrio -->
            <g class="la-chart">
              <polygon points="19,22 32.5,33.5 19,33.5" fill="#ffffff" opacity="0.14" />
              <polygon points="19,45 32.5,33.5 19,33.5" fill="#fcd34d" opacity="0.16" />
              <path d="M14 50 V14 M14 50 H50" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity="0.85" />
              <path d="M19 22 C 29 27, 38 36, 46 45" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" />
              <path d="M19 45 C 29 40, 38 31, 46 22" fill="none" stroke="#fcd34d" stroke-width="3.5" stroke-linecap="round" />
              <circle cx="32.5" cy="33.5" r="7.5" fill="#ffffff" opacity="0.18" />
              <circle cx="32.5" cy="33.5" r="4.5" fill="#ffffff" stroke="#065f46" stroke-width="2" class="la-dot" />
            </g>
            <!-- Barrido de brillo sobre la insignia -->
            <g clip-path="url(#logoLiveClip)">
              <rect x="-26" y="-8" width="18" height="80" fill="url(#logoLiveShine)" class="la-shine" />
            </g>
          </svg>
        </span>
        <span class="brand-shine hidden sm:inline">Ecoudea</span>
      </a>

      <div class="hidden sm:flex items-center gap-1">
        <div class="relative nav-dropdown">
          <a
            href={url(`/#directorio`)}
            class:list={[
              'flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 no-underline',
              currentPath.startsWith(url(`/cursos`)) ? 'text-accent bg-accent-soft' : 'text-text-muted hover:text-text hover:bg-white/5',
            ]}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            Cursos
            <svg class="w-3.5 h-3.5 nav-chevron transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <div class="nav-menu absolute left-0 top-full pt-2 hidden">
            <div class="w-56 rounded-xl glass-card border border-border-subtle shadow-2xl p-2 space-y-0.5">
              <a href={url(`/#directorio`)} class="flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium text-text-muted hover:text-text hover:bg-white/5 transition-all no-underline">
                Todos los cursos
                <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
              {categories.map((cat) => (
                <a href={url(`/?cat=${encodeURIComponent(cat.filter)}#directorio`)} class="block px-3 py-2 rounded-lg text-sm font-medium text-text-muted hover:text-text hover:bg-white/5 transition-all no-underline">
                  {cat.label}
                </a>
              ))}
            </div>
          </div>
        </div>
        {
          navLinks.filter((l) => l.label !== 'Cursos').map((link) => (
            <a
              href={link.href}
              aria-current={currentPath === link.href ? 'page' : undefined}
              class:list={[
                'flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 no-underline',
                currentPath === link.href
                  ? 'text-accent bg-accent-soft'
                  : 'text-text-muted hover:text-text hover:bg-white/5',
              ]}
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={link.icon} />
              </svg>
              {link.label}
            </a>
          ))
        }
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center w-11 h-11 rounded-lg text-text-muted hover:text-text hover:bg-white/5 transition-all no-underline"
          aria-label="Repositorio en GitHub"
          title="Repositorio en GitHub"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg>
        </a>
        <SearchModal base={base} />
        <ThemeToggle />
      </div>

      <div class="sm:hidden flex items-center gap-1">
        <SearchModal base={base} uid="-m" />
        <ThemeToggle />
        <button id="mobile-menu-btn" class="flex items-center justify-center w-11 h-11 rounded-lg text-text-muted hover:text-text hover:bg-white/5 transition-colors border-0 bg-transparent cursor-pointer" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<div id="mobile-menu-overlay" class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm hidden" onclick="this.classList.add('hidden');document.getElementById('mobile-menu').classList.add('hidden')"></div>
<div id="mobile-menu" class="fixed top-14 right-4 z-50 w-56 rounded-xl glass-card border border-border-subtle shadow-2xl hidden">
  <div class="p-2 space-y-1">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath === link.href ? 'page' : undefined}
          class:list={[
            'flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm font-medium transition-all no-underline',
            currentPath === link.href
              ? 'text-accent bg-accent-soft'
              : 'text-text-muted hover:text-text hover:bg-white/5',
          ]}
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={link.icon} />
          </svg>
          {link.label}
        </a>
      ))
    }
    <a
      href={github}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm font-medium text-text-muted hover:text-text hover:bg-white/5 transition-all no-underline"
    >
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
      </svg>
      GitHub
    </a>
  </div>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-menu-overlay');
  if (btn && menu && overlay) {
    const setOpen = (open) => {
      menu.classList.toggle('hidden', !open);
      overlay.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    };
    btn.addEventListener('click', () => {
      setOpen(menu.classList.contains('hidden'));
    });
    overlay.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        setOpen(false);
        btn.focus();
      }
    });
  }
  const dropdown = document.querySelector('.nav-dropdown');
  if (dropdown) {
    const menuEl = dropdown.querySelector('.nav-menu');
    const chevron = dropdown.querySelector('.nav-chevron');
    const show = () => {
      menuEl.classList.remove('hidden');
      if (chevron) chevron.style.transform = 'rotate(180deg)';
    };
    const hide = () => {
      menuEl.classList.add('hidden');
      if (chevron) chevron.style.transform = '';
    };
    dropdown.addEventListener('mouseenter', show);
    dropdown.addEventListener('mouseleave', hide);
    dropdown.addEventListener('click', (e) => {
      if (e.target.closest('a')) return;
      menuEl.classList.toggle('hidden');
    });
  }
</script>
