---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CourseCard from '../components/CourseCard.astro';
import Icon from '../components/ui/Icon.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const courses = await getCollection('courses');
const allClasses = await getCollection('classes');

const sortedCourses = courses.sort((a, b) => a.data.order - b.data.order);
const classCounts = {};
const practiceCounts = {};
for (const cls of allClasses) {
  classCounts[cls.data.course] = (classCounts[cls.data.course] || 0) + 1;
  if (cls.data.classType === 'practica') {
    practiceCounts[cls.data.course] = (practiceCounts[cls.data.course] || 0) + 1;
  }
}

const routes = [
  {
    filter: 'Cursos',
    n: '01',
    icon: 'book',
    tone: 'text-accent border-accent/30 bg-accent-soft',
    title: 'Cursos',
    desc: 'Del fundamento a la inferencia: probabilidad, estadística, muestreo y series de tiempo, paso a paso y con matemáticas claras.',
  },
  {
    filter: 'Guías y Semilleros',
    n: '02',
    icon: 'code',
    tone: 'text-amber-400 border-amber-500/30 bg-amber-500/10',
    title: 'Guías y Semilleros',
    desc: 'Instala R, Python y sus ecosistemas sin pelear con el sistema operativo. Guías por plataforma y semilleros para practicar.',
  },
  {
    filter: 'Sesiones Especiales',
    n: '03',
    icon: 'bulb',
    tone: 'text-rose-400 border-rose-500/30 bg-rose-500/10',
    title: 'Sesiones Especiales',
    desc: 'Seminarios, nivelatorios y presentaciones: material de posgrado y sesiones temáticas con enfoque aplicado.',
  },
];
const categoryCounts = routes.map((r) => ({
  category: r.filter,
  count: sortedCourses.filter((c) => c.data.category === r.filter).length,
}));

const totalClasses = allClasses.length;
const totalPractices = allClasses.filter((c) => c.data.classType === 'practica').length;
const totalGuides = allClasses.filter((c) => c.data.classType === 'guia').length;

// Índice para "Continúa donde lo dejaste" (progreso en localStorage).
const courseTitles = Object.fromEntries(sortedCourses.map((c) => [c.id, c.data.title]));
const classIndex = allClasses.map((c) => ({
  id: c.id,
  c: c.data.course,
  t: c.data.title,
  o: c.data.order,
  ct: courseTitles[c.data.course] || c.data.course,
}));
---

<BaseLayout title="Ecoudea - Cursos de Estadística" description="Cursos de estadística, probabilidad y programación con R y Python">
  <Fragment slot="header">
    <Navbar currentPath="/" />
  </Fragment>

  <!-- ═══ HERO ASIMÉTRICO ═══ -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-accent/10 via-secondary/5 to-transparent pointer-events-none" aria-hidden="true" />
    <div class="absolute top-24 -left-24 w-96 h-96 rounded-full bg-accent/5 blur-3xl pointer-events-none" data-parallax="0.1" aria-hidden="true" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-14 sm:pt-20 sm:pb-20 grid lg:grid-cols-12 gap-10 lg:gap-8 items-center relative">
      <!-- Columna de texto -->
      <div class="lg:col-span-7">
        <p class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent-soft border border-accent/20 text-accent text-xs sm:text-sm font-medium mb-6 reveal is-visible">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse" aria-hidden="true" />
          {totalClasses} clases abiertas · sin registro
        </p>
        <h1 class="font-extrabold tracking-tight mb-5 max-w-xl reveal is-visible" style="font-size: var(--text-hero); line-height: 1.05;">
          La estadística, explicada <span class="gradient-text">como debe ser</span>
        </h1>
        <p class="text-lg sm:text-xl text-text-muted max-w-xl leading-relaxed mb-8 reveal is-visible">
          Cursos y recursos de estadística, probabilidad y programación con R y Python:
          teoría rigurosa, fórmulas legibles y prácticas con datos reales.
        </p>
        <div class="flex items-center gap-4 flex-wrap mb-10 reveal is-visible">
          <a href="#directorio" class="btn no-underline">
            Explorar catálogo
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a href={`${base}/acercade`} class="btn-ghost no-underline">
            Conocer el proyecto
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        <dl class="flex items-stretch gap-5 sm:gap-7 reveal is-visible">
          <div>
            <dt class="sr-only">cursos</dt>
            <dd class="block text-2xl sm:text-3xl font-bold gradient-text-alt tabular-nums" data-count={courses.length}>{courses.length}</dd>
            <dd class="text-xs text-text-muted mt-0.5">cursos</dd>
          </div>
          <div class="w-px bg-border-subtle" aria-hidden="true" />
          <div>
            <dt class="sr-only">clases</dt>
            <dd class="block text-2xl sm:text-3xl font-bold gradient-text-alt tabular-nums" data-count={totalClasses}>{totalClasses}</dd>
            <dd class="text-xs text-text-muted mt-0.5">clases</dd>
          </div>
          <div class="w-px bg-border-subtle" aria-hidden="true" />
          <div>
            <dt class="sr-only">prácticas</dt>
            <dd class="block text-2xl sm:text-3xl font-bold gradient-text-alt tabular-nums" data-count={totalPractices}>{totalPractices}</dd>
            <dd class="text-xs text-text-muted mt-0.5">prácticas</dd>
          </div>
          <div class="w-px bg-border-subtle hidden sm:block" aria-hidden="true" />
          <div class="hidden sm:block">
            <dt class="sr-only">guías</dt>
            <dd class="block text-2xl sm:text-3xl font-bold gradient-text-alt tabular-nums" data-count={totalGuides}>{totalGuides}</dd>
            <dd class="text-xs text-text-muted mt-0.5">guías</dd>
          </div>
        </dl>
      </div>

      <!-- Pieza visual: oferta y demanda -->
      <div class="lg:col-span-5 reveal is-visible">
        <div class="relative rounded-3xl border border-border-subtle bg-elevated/50 p-5 sm:p-7 shadow-xl overflow-hidden">
          <div class="absolute -top-16 -right-16 w-56 h-56 rounded-full bg-secondary/10 blur-3xl pointer-events-none" aria-hidden="true" />
          <svg viewBox="0 0 400 300" class="w-full h-auto" role="img" aria-label="Curvas de oferta y demanda cruzándose en el punto de equilibrio">
            <g stroke="currentColor" class="text-border-subtle" stroke-width="1" aria-hidden="true">
              <line x1="40" y1="20" x2="40" y2="270" />
              <line x1="40" y1="270" x2="380" y2="270" />
              {Array.from({ length: 6 }).map((_, i) => (
                <line x1={70 + i * 55} y1="20" x2={70 + i * 55} y2="270" stroke-dasharray="3 6" opacity="0.6" />
              ))}
              {Array.from({ length: 5 }).map((_, i) => (
                <line x1="40" y1={50 + i * 48} x2="380" y2={50 + i * 48} stroke-dasharray="3 6" opacity="0.6" />
              ))}
            </g>
            <text x="30" y="40" text-anchor="end" font-size="13" class="fill-text-muted">P</text>
            <text x="365" y="292" text-anchor="middle" font-size="13" class="fill-text-muted">Q</text>
            <path d="M55 60 C 150 90, 230 170, 340 240" fill="none" stroke="#0284c7" stroke-width="3.5" stroke-linecap="round" class="eco-draw" />
            <path d="M55 240 C 160 210, 250 140, 340 60" fill="none" stroke="#d97706" stroke-width="3.5" stroke-linecap="round" class="eco-draw eco-draw-2" />
            <line x1="198" y1="152" x2="198" y2="270" stroke="#6c9a06" stroke-width="1.5" stroke-dasharray="5 5" />
            <line x1="40" y1="152" x2="198" y2="152" stroke="#6c9a06" stroke-width="1.5" stroke-dasharray="5 5" />
            <circle cx="198" cy="152" r="7" fill="#6c9a06" stroke="#fff" stroke-width="2.5" />
            <text x="212" y="146" font-size="15" font-weight="700" class="fill-text">E</text>
            <text x="330" y="80" font-size="15" font-weight="700" fill="#0284c7">D</text>
            <text x="330" y="228" font-size="15" font-weight="700" fill="#d97706">O</text>
          </svg>
          <div class="flex items-center justify-between gap-3 mt-4 flex-wrap">
            <p class="text-xs text-text-muted">Cada concepto, con su figura y su intuición.</p>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent">
              <Icon name="chart" class="w-4 h-4" /> R · Python · LaTeX
            </span>
          </div>
          <div class="absolute top-4 right-4 hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-full glass-card text-[11px] font-semibold text-text float-soft" aria-hidden="true">
            <span class="w-1.5 h-1.5 rounded-full bg-accent" /> Equilibrio E
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .eco-draw {
      stroke-dasharray: 700;
      stroke-dashoffset: 700;
      animation: eco-draw 1.6s var(--ease-out-expo, cubic-bezier(0.16,1,0.3,1)) 0.3s forwards;
    }
    .eco-draw-2 { animation-delay: 0.7s; }
    @keyframes eco-draw { to { stroke-dashoffset: 0; } }
    .float-soft { animation: float-soft 5s ease-in-out infinite; }
    @keyframes float-soft { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  </style>

  <!-- ═══ RUTAS DE APRENDIZAJE (editorial, no tarjetas clonadas) ═══ -->
  <section class="border-y border-border-subtle bg-elevated/30" aria-labelledby="rutas-title">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-24">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent mb-3 reveal">Por dónde empiezo</p>
          <h2 id="rutas-title" class="text-2xl sm:text-3xl font-bold text-text text-balance reveal">Tres rutas,<br />un mismo rigor</h2>
          <p class="text-text-muted mt-3 leading-relaxed reveal" data-reveal-group>
            Elige tu camino y filtra el catálogo con un clic. Todo es abierto, sin prerrequisitos ocultos.
          </p>
        </div>
      </div>
      <ol class="lg:col-span-8 divide-y divide-border-subtle border-y border-border-subtle list-none m-0 p-0">
        {routes.map((r) => {
          const n = categoryCounts.find((c) => c.category === r.filter)?.count ?? 0;
          return (
            <li>
              <a
                href="#directorio"
                data-route-filter={r.filter}
                class="group flex items-center gap-4 sm:gap-6 py-5 sm:py-6 no-underline reveal"
              >
                <span class="text-sm font-bold text-text-muted tabular-nums w-8 shrink-0" aria-hidden="true">{r.n}</span>
                <span class={`hidden sm:flex w-12 h-12 rounded-2xl border items-center justify-center shrink-0 ${r.tone}`} aria-hidden="true">
                  <Icon name={r.icon} class="w-6 h-6" />
                </span>
                <span class="flex-1 min-w-0">
                  <span class="flex items-baseline gap-2 flex-wrap">
                    <span class="text-lg font-bold text-text group-hover:text-accent transition-colors">{r.title}</span>
                    <span class="text-xs text-text-muted">{n} {n === 1 ? 'curso' : 'cursos'}</span>
                  </span>
                  <span class="block text-sm text-text-muted leading-relaxed mt-1">{r.desc}</span>
                </span>
                <span class="shrink-0 w-10 h-10 rounded-full border border-border-subtle flex items-center justify-center text-text-muted group-hover:text-accent group-hover:border-accent/50 group-hover:translate-x-1 transition-all" aria-hidden="true">
                  <Icon name="arrow-right" class="w-4 h-4" />
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- ═══ DIRECTORIO ═══ -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20" id="directorio">
    <div class="flex items-end justify-between gap-4 flex-wrap mb-6 reveal" data-reveal-group>
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent mb-2">Catálogo</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-text">Encuentra tu próximo curso</h2>
        <p class="text-sm text-text-muted mt-1">Busca por título, descripción o tema.</p>
      </div>
      <span class="text-sm text-text-muted shrink-0" id="results-count" role="status"></span>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 mb-8 reveal" data-reveal-group>
      <div class="relative flex-1 max-w-md">
        <svg class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="course-search"
          type="search"
          placeholder="Buscar un curso…"
          aria-label="Buscar un curso"
          class="w-full bg-elevated/60 border border-border-subtle rounded-lg pl-11 pr-4 py-2.5 text-sm text-text placeholder:text-text-muted/50 focus:outline-none focus:border-accent/50 focus:ring-2 focus:ring-accent/20 transition-all"
        />
      </div>
      <div class="flex flex-wrap items-center gap-2" id="category-pills" role="group" aria-label="Filtrar por categoría">
        <button class="pill pill-active" data-filter="todos">
          Todos <span class="pill-count">{courses.length}</span>
        </button>
        {categoryCounts.filter(({ count }) => count > 0).map(({ category, count }) => (
          <button class="pill" data-filter={category}>
            {category} <span class="pill-count">{count}</span>
          </button>
        ))}
      </div>
    </div>

    <div id="course-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {sortedCourses.map((course, i) => (
        <div
          class={`reveal d-${Math.min(i + 1, 10)}`}
          data-course-card
          data-title={course.data.title.toLowerCase()}
          data-desc={(course.data.description || '').toLowerCase()}
          data-category={course.data.category}
        >
          <CourseCard course={course} classCount={classCounts[course.id] || 0} practiceCount={practiceCounts[course.id] || 0} />
        </div>
      ))}
    </div>

    <div id="empty-state" class="hidden text-center py-16">
      <div class="text-4xl mb-3" aria-hidden="true">🛰</div>
      <p class="text-text-muted font-medium">No hay nada por este rincón.</p>
      <p class="text-sm text-text-muted/60 mt-1">Prueba otra búsqueda o explora todas las categorías.</p>
      <button id="clear-filters" class="btn-ghost mt-6 text-sm no-underline cursor-pointer">Limpiar filtros</button>
    </div>
  </div>

  <!-- ═══ CONTINÚA DONDE LO DEJASTE ═══ -->
  <section id="continua" class="hidden border-t border-border-subtle" aria-labelledby="continua-title">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-14">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-10 h-10 rounded-xl bg-secondary/10 border border-secondary/30 text-secondary flex items-center justify-center" aria-hidden="true">
          <Icon name="clock" class="w-5 h-5" />
        </span>
        <div>
          <h2 id="continua-title" class="text-xl sm:text-2xl font-bold text-text">Continúa donde lo dejaste</h2>
          <p class="text-sm text-text-muted">Tu progreso vive en este navegador.</p>
        </div>
      </div>
      <ul id="continua-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 list-none m-0 p-0"></ul>
    </div>
  </section>

  <!-- ═══ CIERRE: banda horizontal (no un clon del hero) ═══ -->
  <section class="border-t border-border-subtle bg-gradient-to-r from-accent/10 via-elevated/40 to-secondary/10" aria-labelledby="cta-title">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 flex flex-col md:flex-row md:items-center gap-8">
      <div class="flex-1">
        <h2 id="cta-title" class="text-2xl sm:text-3xl font-bold text-text reveal">Elige tu ruta y empieza hoy</h2>
        <p class="text-text-muted mt-2 max-w-xl reveal" data-reveal-group>
          {courses.length} cursos, {totalClasses} clases y {totalPractices} prácticas.
          Sin registros, sin costos, sin fricción.
        </p>
      </div>
      <div class="flex items-center gap-3 flex-wrap shrink-0 reveal" data-reveal-group>
        <a href="#directorio" class="btn no-underline">
          Ver el catálogo
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
        <a href={`${base}/tablero-latex`} class="btn-ghost no-underline">
          Probar el tablero LaTeX
        </a>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>

<script define:vars={{ base, classIndex }}>
  const searchInput = document.getElementById('course-search');
  const pills = document.querySelectorAll('#category-pills .pill');
  const cards = document.querySelectorAll('[data-course-card]');
  const resultsCount = document.getElementById('results-count');
  const emptyState = document.getElementById('empty-state');
  let activeFilter = new URLSearchParams(window.location.search).get('cat') || 'todos';

  const urlPill = [...pills].find((p) => p.dataset.filter === activeFilter);
  if (urlPill) {
    pills.forEach((p) => p.classList.toggle('pill-active', p === urlPill));
  }

  function setFilter(f) {
    activeFilter = f;
    pills.forEach((p) => p.classList.toggle('pill-active', p.dataset.filter === f));
    applyFilters();
  }

  function applyFilters() {
    const q = (searchInput?.value || '').trim().toLowerCase();
    let shown = 0;
    cards.forEach((card) => {
      const catOk = activeFilter === 'todos' || card.dataset.category === activeFilter;
      const qOk = !q || card.dataset.title.includes(q) || card.dataset.desc.includes(q);
      const show = catOk && qOk;
      card.classList.toggle('hidden', !show);
      if (show) shown++;
    });
    resultsCount.textContent = `${shown} ${shown === 1 ? 'curso' : 'cursos'} encontrados`;
    emptyState.classList.toggle('hidden', shown > 0);
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => setFilter(pill.dataset.filter));
  });

  // Las rutas de aprendizaje filtran el catálogo sin recargar.
  document.querySelectorAll('[data-route-filter]').forEach((a) => {
    a.addEventListener('click', () => setFilter(a.dataset.routeFilter));
  });

  searchInput?.addEventListener('input', applyFilters);

  document.getElementById('clear-filters')?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    setFilter('todos');
  });

  applyFilters();

  // ── Continúa donde lo dejaste ──────────────────────────────────────
  try {
    const items = [];
    for (let i = 0; i < localStorage.length && items.length < 3; i++) {
      const key = localStorage.key(i);
      if (!key || !key.startsWith('ecoudea-progress-')) continue;
      const courseId = key.replace('ecoudea-progress-', '');
      const done = JSON.parse(localStorage.getItem(key) || '[]');
      if (!done.length) continue;
      const mine = classIndex.filter((c) => c.c === courseId).sort((a, b) => a.o - b.o);
      if (!mine.length) continue;
      const doneOrders = new Set(mine.filter((c) => done.includes(c.id)).map((c) => c.o));
      const next = mine.find((c) => !doneOrders.has(c.o)) || mine[mine.length - 1];
      const pct = Math.round((doneOrders.size / mine.length) * 100);
      items.push({ courseId, next, pct, total: mine.length, done: doneOrders.size });
    }
    if (items.length) {
      const sec = document.getElementById('continua');
      const list = document.getElementById('continua-list');
      sec.classList.remove('hidden');
      list.innerHTML = items.map(({ courseId, next, pct, total, done }) => `
        <li>
          <a href="${base}/cursos/${courseId}/${next.id}" class="flex flex-col gap-2 p-4 rounded-xl border border-border-subtle no-underline card-hover h-full">
            <span class="text-[11px] font-bold uppercase tracking-wider text-secondary">${next.ct}</span>
            <span class="text-sm font-bold text-text leading-snug">Siguiente: ${next.t}</span>
            <span class="mt-auto flex items-center gap-2 text-xs text-text-muted">
              <span class="flex-1 h-1.5 rounded-full bg-white/10 overflow-hidden"><span class="block h-full rounded-full bg-gradient-to-r from-accent to-secondary" style="width:${pct}%"></span></span>
              <span class="tabular-nums">${done}/${total}</span>
            </span>
          </a>
        </li>`).join('');
    }
  } catch (e) {}
</script>

<script type="application/json" id="class-index" set:html={JSON.stringify(classIndex)} />
