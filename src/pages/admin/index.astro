---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { createHash } from 'node:crypto';

const base = import.meta.env.BASE_URL;
const courses = await getCollection('courses');
const allClasses = await getCollection('classes');
const sortedCourses = courses.sort((a, b) => a.data.order - b.data.order);

const adminPassword = import.meta.env.ADMIN_PASSWORD || 'ecoudea-admin';
const adminHash = createHash('sha256').update(adminPassword).digest('hex');
const isDefaultPassword = !import.meta.env.ADMIN_PASSWORD;
---

<BaseLayout title="Admin - Ecoudea" description="Panel de administración de Ecoudea" noindex={true}>
  <Fragment slot="header">
    <nav class="sticky top-0 z-50 border-b border-border-subtle" style="background: oklch(from #0b1120 l c h / 0.85); backdrop-filter: blur(16px) saturate(180%);">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-14 sm:h-16">
          <a href={`${base}/`} class="flex items-center gap-3 font-bold text-lg sm:text-xl text-text no-underline">
            <span class="text-lg font-bold gradient-text">Admin · Ecoudea</span>
          </a>
          <a href={`${base}/`} class="text-sm text-text-muted hover:text-accent transition-colors no-underline">← Volver al sitio</a>
        </div>
      </div>
    </nav>
  </Fragment>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <h1 class="text-2xl sm:text-3xl font-bold text-text mb-6">Panel de administración</h1>

    <div id="login-view">
      {isDefaultPassword && (
        <div class="mb-6 px-4 py-3 rounded-xl border border-amber-500/30 bg-amber-500/10 text-amber-300 text-sm">
          ⚠ Estás usando la contraseña por defecto. Para personalizarla, define la variable
          <code class="font-mono text-xs">ADMIN_PASSWORD</code> en el build (GitHub Actions → Settings → Secrets → Actions).
        </div>
      )}
      <form id="login-form" class="max-w-sm space-y-4">
        <div>
          <label for="admin-password" class="block text-sm font-medium text-text mb-1.5">Contraseña de administrador</label>
          <input
            id="admin-password"
            type="password"
            required
            placeholder="••••••••"
            class="w-full bg-elevated/60 border border-border-subtle rounded-lg px-4 py-2.5 text-sm text-text placeholder:text-text-muted/50 focus:outline-none focus:border-accent/50 focus:ring-2 focus:ring-accent/20 transition-all"
          />
        </div>
        <button type="submit" class="btn w-full justify-center no-underline cursor-pointer">Entrar</button>
        <p id="login-error" class="hidden text-sm text-rose-400">Contraseña incorrecta.</p>
      </form>
    </div>

    <div id="admin-view" class="hidden">
      <div class="flex items-center justify-between mb-6">
        <p class="text-sm text-text-muted">Gestiona la configuración y el resumen de cada curso.</p>
        <button id="logout-btn" class="btn-ghost text-sm px-3 py-1.5 no-underline cursor-pointer">Cerrar sesión</button>
      </div>

      <div class="space-y-2">
        {sortedCourses.map((course) => {
          const classCount = allClasses.filter((c) => c.data.course === course.id).length;
          const practicas = allClasses.filter((c) => c.data.course === course.id && c.data.classType === 'practica').length;
          const locked = course.data.unlockMode === 'sequential';
          return (
            <a
              href={`${base}/admin/${course.id}`}
              class="flex items-center gap-4 p-4 rounded-xl border border-border-subtle no-underline card-hover"
            >
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h2 class="text-sm font-bold text-text truncate">{course.data.title}</h2>
                  {locked && (
                    <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full border border-secondary/40 bg-secondary-soft text-secondary">
                      secuencial
                    </span>
                  )}
                </div>
                <p class="text-xs text-text-muted mt-0.5">{course.data.category} · {classCount} clases · {practicas} prácticas</p>
              </div>
              <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          );
        })}
      </div>
    </div>
  </div>

  <Fragment slot="footer">
    <div class="border-t border-border-subtle mt-auto">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 text-center text-xs text-text-muted/60">
        Panel interno · No indexado por buscadores · {new Date().getFullYear()} Ecoudea
      </div>
    </div>
  </Fragment>
</BaseLayout>

<script is:inline define:vars={{ adminHash, base }}>
  (() => {
    const ADMIN_HASH = adminHash;
    const loginView = document.getElementById('login-view');
    const adminView = document.getElementById('admin-view');
    const form = document.getElementById('login-form');
    const error = document.getElementById('login-error');

    async function sha256(text) {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
      return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, '0')).join('');
    }

    async function tryLogin() {
      if (sessionStorage.getItem('ecoudea-admin-auth') === '1') {
        loginView.classList.add('hidden');
        adminView.classList.remove('hidden');
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('admin-password');
      const hash = await sha256(input.value);
      if (hash === ADMIN_HASH) {
        sessionStorage.setItem('ecoudea-admin-auth', '1');
        error.classList.add('hidden');
        loginView.classList.add('hidden');
        adminView.classList.remove('hidden');
      } else {
        error.classList.remove('hidden');
      }
    });

    document.getElementById('logout-btn').addEventListener('click', () => {
      sessionStorage.removeItem('ecoudea-admin-auth');
      adminView.classList.add('hidden');
      loginView.classList.remove('hidden');
      const input = document.getElementById('admin-password');
      if (input) input.value = '';
    });

    tryLogin();
  })();
</script>
