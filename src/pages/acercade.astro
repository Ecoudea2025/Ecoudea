---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const courses = await getCollection('courses');
const allClasses = await getCollection('classes');
const totalClasses = allClasses.length;
const totalPractices = allClasses.filter((c) => c.data.classType === 'practica').length;
const totalGuides = allClasses.filter((c) => c.data.classType === 'guia').length;
const sortedCourses = courses.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Acerca de - Ecoudea" description="Acerca de Ecoudea: cursos abiertos de estadística, probabilidad y programación con R y Python">
  <Fragment slot="header">
    <Navbar currentPath={`${base}/acercade`} />
  </Fragment>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-bold text-text mb-3 reveal">Acerca de Ecoudea</h1>
    <p class="text-text-muted mb-10 reveal" data-reveal-group>
      Plataforma abierta de cursos de estadística, probabilidad y programación con R y Python.
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-12">
      {[
        { value: courses.length, label: 'cursos' },
        { value: totalClasses, label: 'clases' },
        { value: totalPractices, label: 'prácticas' },
        { value: totalGuides, label: 'guías' },
      ].map((s) => (
        <div class="rounded-xl border border-border-subtle bg-elevated/50 p-4 text-center reveal">
          <span class="block text-2xl sm:text-3xl font-bold gradient-text-alt tabular-nums" data-count={s.value}>{s.value}</span>
          <span class="text-xs text-text-muted">{s.label}</span>
        </div>
      ))}
    </div>

    <div class="prose-class">
      <p>
        Ecoudea es una plataforma de cursos y recursos académicos enfocados en estadística,
        probabilidad y programación. El objetivo es proporcionar materiales de alta calidad,
        organizados y de acceso abierto para estudiantes y profesionales.
      </p>
      <p>
        Los cursos cubren desde fundamentos de probabilidad hasta técnicas avanzadas de
        estadística inferencial, series de tiempo y muestreo, con aplicaciones prácticas en
        <strong> R </strong> y <strong> Python </strong>.
      </p>
      <h2>Tecnología</h2>
      <p>
        Este sitio está construido con <strong>Astro</strong> y <strong>Tailwind CSS</strong>,
        generado como sitio estático para máxima velocidad y eficiencia, con matemáticas
        renderizadas con KaTeX y desplegado en GitHub Pages.
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3">
      <a
        href="https://github.com/Ecoudea2025/Ecoudea"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between gap-3 p-4 rounded-xl border border-border-subtle no-underline card-hover"
      >
        <span class="flex items-center gap-3">
          <svg class="w-5 h-5 text-accent shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
          <span class="text-sm font-semibold text-text">Repositorio de Ecoudea</span>
        </span>
        <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
      </a>
      <a
        href="https://github.com/jiperezga"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between gap-3 p-4 rounded-xl border border-border-subtle no-underline card-hover"
      >
        <span class="flex items-center gap-3">
          <svg class="w-5 h-5 text-secondary shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
          <span class="text-sm font-semibold text-text">GitHub del profesor (contenido original)</span>
        </span>
        <svg class="w-4 h-4 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
      </a>
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-bold text-text mb-4">Cursos disponibles</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {sortedCourses.map((course) => (
          <a
            href={`${base}/cursos/${course.id}`}
            class="flex items-center justify-between gap-3 p-4 rounded-xl border border-border-subtle no-underline card-hover"
          >
            <span class="text-sm font-semibold text-text">{course.data.title}</span>
            <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
