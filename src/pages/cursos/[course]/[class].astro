---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import VideoPlayer from '../../../components/VideoPlayer.astro';
import { getCollection, render } from 'astro:content';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const classes = await getCollection('classes');
  return classes.map((cls) => ({
    params: { course: cls.data.course, class: cls.id },
    props: { courseId: cls.data.course, classId: cls.id },
  }));
}

const { courseId, classId } = Astro.props;

const allClasses = await getCollection('classes');
const courses = await getCollection('courses');
const course = courses.find((c) => c.id === courseId);
const classEntry = allClasses.find((c) => c.id === classId);

if (!course || !classEntry) { return Astro.redirect('/404'); }

const { Content } = await render(classEntry);
const sorted = allClasses.filter((c) => c.data.course === courseId).sort((a, b) => a.data.order - b.data.order);
const idx = sorted.findIndex((c) => c.id === classId);
const prevClass = idx > 0 ? sorted[idx - 1] : null;
const nextClass = idx < sorted.length - 1 ? sorted[idx + 1] : null;
const classNum = idx + 1;
const totalInCourse = sorted.length;

const typeColors = {
  clase: 'border-accent text-accent bg-accent-soft',
  practica: 'border-rose-500 text-rose-400 bg-rose-500/10',
  presentacion: 'border-gray-500 text-gray-400 bg-gray-500/10',
  guia: 'border-amber-500 text-amber-400 bg-amber-500/10',
};
const typeLabels = { clase: 'Clase', practica: 'Práctica', presentacion: 'Presentación', guia: 'Guía' };
const tc = typeColors[classEntry.data.classType] || typeColors.clase;
const tl = typeLabels[classEntry.data.classType] || 'Clase';
---

<BaseLayout title={`${classEntry.data.title} - ${course.data.title} - Ecoudea`} description={classEntry.data.description} showTools={true} math={true} unlock={true}>
  <Fragment slot="header"><Navbar currentPath={`${base}/cursos/${courseId}/${classId}`} /></Fragment>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <nav class="flex items-center gap-2 text-sm text-text-muted mb-6 flex-wrap">
      <a href={`${base}/`} class="hover:text-accent transition-colors no-underline">Inicio</a>
      <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      <a href={`${base}/cursos/${courseId}`} class="hover:text-accent transition-colors no-underline truncate max-w-[180px] sm:max-w-[300px]">{course.data.title}</a>
      <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      <span class="text-text truncate max-w-[180px] sm:max-w-[300px]">{classEntry.data.title}</span>
    </nav>

    <div class="relative overflow-hidden rounded-2xl gradient-bg border border-accent/20 shadow-xl shadow-accent/5 p-5 sm:p-8 mb-6">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-accent via-secondary to-accent" aria-hidden="true" />
      <div class="absolute -top-10 -right-10 w-64 h-64 rounded-full bg-accent/10 blur-3xl pointer-events-none" />
      <div class="absolute -bottom-12 left-10 w-48 h-48 rounded-full bg-secondary/10 blur-3xl pointer-events-none" />
      <div class="flex items-start gap-4 sm:gap-5 relative z-10">
        <div class={`shrink-0 w-14 h-14 sm:w-16 sm:h-16 rounded-2xl border-2 ${tc} bg-surface/60 backdrop-blur flex items-center justify-center text-xl sm:text-2xl font-extrabold tabular-nums shadow-lg`}>{classNum}</div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-2 flex-wrap">
            <span class={`text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full border ${tc}`}>{tl}</span>
            <span class="text-[11px] text-text-muted tabular-nums">{classNum} de {totalInCourse} · {course.data.title}</span>
          </div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-text leading-tight">{classEntry.data.title}</h1>
          {classEntry.data.description && <p class="text-sm sm:text-base text-text-muted mt-2 leading-relaxed max-w-3xl">{classEntry.data.description}</p>}
          <div class="mt-4 max-w-md">
            <div class="flex items-center justify-between text-[11px] text-text-muted mb-1.5">
              <span>Progreso del curso</span>
              <span class="tabular-nums">{Math.round((classNum / totalInCourse) * 100)}%</span>
            </div>
            <div class="h-2 rounded-full bg-white/10 overflow-hidden">
              <div class="h-full rounded-full bg-gradient-to-r from-accent to-secondary" style={`width: ${(classNum / totalInCourse) * 100}%`} />
            </div>
          </div>
        </div>
        <button id="progress-btn" data-course={courseId} data-class={classId} class="shrink-0 w-11 h-11 sm:w-12 sm:h-12 rounded-2xl border-2 border-border-subtle bg-surface/60 backdrop-blur text-text-muted hover:border-accent/60 hover:text-accent hover:shadow-lg hover:shadow-accent/10 flex items-center justify-center transition-all cursor-pointer" aria-label="Marcar como completado" title="Marcar como completada">
          <svg id="progress-check" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
        </button>
      </div>
    </div>

    <div class="lg:flex lg:gap-8" data-class-content data-course-id={courseId} data-class-id={classId} data-prev-id={prevClass ? prevClass.id : ''} data-unlock={course.data.unlockMode || 'open'}>
      <div class="flex-1 min-w-0">
        {(classEntry.data.video || classEntry.data.videoFallback) && (
          <div class="mb-6 reveal is-visible">
            <VideoPlayer
              src={classEntry.data.video}
              poster={classEntry.data.videoPoster}
              fallback={classEntry.data.videoFallback}
              captions={classEntry.data.videoCaptions}
              title={classEntry.data.title}
            />
          </div>
        )}
        <article class="prose-class"><Content /></article>
      </div>
      <aside id="class-toc" class="hidden lg:block lg:w-56 shrink-0 mt-6 lg:mt-0">
        <div class="sticky top-24">
          <h4 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-3">Contenido</h4>
          <nav class="border-l-2 border-accent/20 pl-3"></nav>
        </div>
      </aside>
    </div>

    <div id="class-lock" class="hidden relative overflow-hidden rounded-2xl gradient-bg border border-secondary/30 p-8 sm:p-12 my-6 text-center">
      <div class="absolute top-0 right-0 w-48 h-48 rounded-full bg-secondary/10 blur-3xl pointer-events-none" />
      <div class="relative z-10">
        <div class="w-14 h-14 mx-auto rounded-2xl bg-secondary-soft border border-secondary/30 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-text mb-2">Clase bloqueada</h2>
        <p class="text-text-muted text-sm max-w-md mx-auto mb-6">
          Este contenido se desbloquea al completar la clase anterior del curso.
          Marca como completada la clase anterior y vuelve aquí.
        </p>
        {prevClass && (
          <a href={`${base}/cursos/${courseId}/${prevClass.id}`} class="btn no-underline">
            Ir a la clase anterior
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
          </a>
        )}
      </div>
    </div>

    <div class="section-divider mt-10 mb-6"></div>

    <div class="flex items-center justify-between gap-4">
      {prevClass ? (
        <a         href={`${base}/cursos/${courseId}/${prevClass.id}`} class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-border-subtle text-sm font-medium text-text hover:border-accent/50 hover:text-accent transition-all no-underline card-hover max-w-[45%]">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
          <span class="hidden sm:inline truncate max-w-[200px]">{prevClass.data.title}</span><span class="sm:hidden">Anterior</span>
        </a>
      ) : <div />}
      <div class="flex items-center gap-2 text-xs text-text-muted">
        <span class="hidden sm:inline">{classNum}/{totalInCourse}</span>
        <div class="w-20 h-1.5 rounded-full bg-white/10 overflow-hidden hidden sm:block">
          <div class="h-full rounded-full bg-accent" style={`width: ${(classNum / totalInCourse) * 100}%`} />
        </div>
      </div>
      {nextClass ? (
        <a         href={`${base}/cursos/${courseId}/${nextClass.id}`} class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-border-subtle text-sm font-medium text-text hover:border-accent/50 hover:text-accent transition-all no-underline card-hover max-w-[45%]">
          <span class="hidden sm:inline truncate max-w-[200px]">{nextClass.data.title}</span><span class="sm:hidden">Siguiente</span>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      ) : <div />}
    </div>
  </div>

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>

<script>
  (() => {
    const btn = document.getElementById('progress-btn');
    if (!btn) return;
    const key = 'ecoudea-progress-' + btn.dataset.course;
    const classKey = btn.dataset.class;
    let done = new Set(JSON.parse(localStorage.getItem(key) || '[]'));
    const update = () => {
      const completed = done.has(classKey);
      btn.className = completed
        ? 'shrink-0 w-10 h-10 rounded-xl border-2 border-emerald-500 bg-emerald-500/20 text-emerald-400 flex items-center justify-center transition-all cursor-pointer'
        : 'shrink-0 w-10 h-10 rounded-xl border-2 border-border-subtle text-text-muted hover:border-accent/50 hover:text-accent flex items-center justify-center transition-all cursor-pointer';
    };
    update();
    btn.addEventListener('click', () => {
      if (done.has(classKey)) done.delete(classKey);
      else done.add(classKey);
      localStorage.setItem(key, JSON.stringify([...done]));
      update();
      window.dispatchEvent(new CustomEvent('ecoudea:progress', { detail: { courseId: btn.dataset.course } }));
    });

    // ── Bloqueo progresivo: si la anterior no está completada, ocultar contenido ──
    const content = document.querySelector('[data-class-content]');
    const lockBox = document.getElementById('class-lock');
    if (content && lockBox && window.EcoudeaUnlock) {
      const courseId = content.dataset.courseId;
      const unlockMode = content.dataset.unlock;
      const prevId = content.dataset.prevId;
      const isLocked = () => {
        if (unlockMode !== 'sequential' || !prevId) return false;
        if (EcoudeaUnlock.isAdminUnlocked()) return false;
        const progress = EcoudeaUnlock.getProgress(courseId);
        return !progress.has(prevId);
      };
      const apply = () => {
        const locked = isLocked();
        content.classList.toggle('hidden', locked);
        lockBox.classList.toggle('hidden', !locked);
        if (locked) window.scrollTo({ top: 0, behavior: 'smooth' });
      };
      window.addEventListener('ecoudea:progress', (e) => {
        if (e.detail && e.detail.courseId === courseId) apply();
      });
      document.addEventListener('DOMContentLoaded', apply);
      setTimeout(apply, 50); // unlock.js carga con defer; asegurar evaluación
    }
  })();
</script>
