---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import manifest from '../../../archive/manifest.json';
import { url } from '../../lib/url';

const base = import.meta.env.BASE_URL;
const archivedIds = new Set(manifest.courses.map((c) => c.id));

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  const active = courses.map((c) => ({
    params: { course: c.id },
    props: { courseId: c.id, archived: null },
  }));
  // Stubs para URLs viejas: mismo path, aviso de archivado (no indexado).
  const stubs = manifest.courses.map((c) => ({
    params: { course: c.id },
    props: { courseId: c.id, archived: c },
  }));
  return [...active, ...stubs];
}

const { courseId, archived } = Astro.props;
const allClasses = (await getCollection('classes')).filter((c) => !c.data.draft);
const courses = await getCollection('courses');
const course = courses.find((c) => c.id === courseId);

if (!course && !archived) { return Astro.redirect('/404'); }

const sortedClasses = course ? allClasses.filter((c) => c.data.course === courseId).sort((a, b) => a.data.order - b.data.order) : [];
// Unidades: agrupa por `unit` del frontmatter (opcional); sin unidades, un solo grupo.
const units = [];
for (const entry of sortedClasses) {
  const name = entry.data.unit || 'Contenido';
  let g = units.find((u) => u.name === name);
  if (!g) { g = { name, items: [] }; units.push(g); }
  g.items.push(entry);
}
const typeColors = {
  clase: 'border-accent text-accent bg-accent-soft',
  practica: 'border-rose-500 text-rose-400 bg-rose-500/10',
  presentacion: 'border-gray-500 text-gray-400 bg-gray-500/10',
  guia: 'border-amber-500 text-amber-400 bg-amber-500/10',
};
const typeLabels = { clase: 'Clase', practica: 'Práctica', presentacion: 'Presentación', guia: 'Guía' };

const classCount = sortedClasses.length;
const practicaCount = sortedClasses.filter(c => c.data.classType === 'practica').length;

const jsonLd = course ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: course.data.title,
  description: course.data.description,
  provider: { '@type': 'Organization', name: 'Ecoudea' },
  numberOfCredits: classCount,
  inLanguage: 'es-CO',
}) : '';
const pageTitle = course ? `${course.data.title} - Ecoudea` : `Curso archivado: ${archived?.title || courseId} - Ecoudea`;
const pageDesc = course ? course.data.description : 'Este curso fue archivado. Explora el catálogo actual de Ecoudea.';
---

<BaseLayout title={pageTitle} description={pageDesc} jsonLd={course ? jsonLd : undefined} noindex={archived ? true : undefined}>
  <Fragment slot="header"><Navbar currentPath={url(`/cursos/${courseId}`)} /></Fragment>

  {archived ? (
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 text-center" data-pagefind-ignore>
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-amber-400 mb-3">Curso archivado</p>
      <h1 class="text-2xl sm:text-3xl font-bold text-text mb-3">{archived.title}</h1>
      <p class="text-text-muted leading-relaxed mb-8">
        Este curso se archivó durante la reestructuración de la plataforma.
        Su material se conserva en el repositorio. Mientras tanto, el catálogo actual sigue creciendo.
      </p>
      <div class="flex items-center justify-center gap-3 flex-wrap">
        <a href={url(`/#directorio`)} class="btn no-underline">Ver catálogo actual</a>
        <a href="https://github.com/Ecoudea2025/Ecoudea" target="_blank" rel="noopener noreferrer" class="btn-ghost no-underline">Ver material archivado</a>
      </div>
    </div>
  ) : (
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Header del curso -->
    <div class="relative overflow-hidden rounded-2xl gradient-bg border border-border-subtle p-6 sm:p-8 mb-8">
      <div class="absolute top-0 right-0 w-64 h-64 rounded-full bg-accent/5 blur-3xl pointer-events-none" />
      <div class="absolute bottom-0 left-20 w-48 h-48 rounded-full bg-secondary/5 blur-3xl pointer-events-none" />

      <div class="relative z-10">
        <Breadcrumbs items={[{ label: 'Inicio', href: url('/') }, { label: course.data.title }]} />
      </div>

      <div class="flex flex-col sm:flex-row items-start gap-6 relative z-10">
        {course.data.image && (
          <div class="w-full sm:w-56 shrink-0 rounded-xl overflow-hidden border border-accent/20 shadow-lg">
            <img src={url(course.data.image)} alt={course.data.title} class="w-full h-40 sm:h-36 object-cover" loading="lazy" />
          </div>
        )}
        <div class="flex-1 min-w-0">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-accent-soft text-accent border border-accent/30 mb-3">
            {course.data.category}
          </span>
          <h1 class="text-2xl sm:text-3xl font-bold text-text mb-2 gradient-text">{course.data.title}</h1>
          <p class="text-text-muted text-sm sm:text-base leading-relaxed">{course.data.description}</p>
          {course.data.author && (
            <p class="text-xs text-text-muted mt-2">Material de {course.data.author} · conservado con crédito del autor</p>
          )}
          <div class="flex flex-wrap items-center gap-4 mt-4 text-sm text-text-muted">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
              <span class="font-semibold text-text">{classCount}</span> clases
            </span>
            {practicaCount > 0 && (
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="font-semibold text-text">{practicaCount}</span> prácticas
              </span>
            )}
            <span class="items-center gap-1.5 hidden" data-progress-wrap>
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span class="font-semibold text-text" data-progress-text>0/{classCount}</span>
              <span>completadas</span>
            </span>
          </div>
          <div class="flex flex-wrap items-center gap-2 mt-4">
            <button type="button" data-export class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border border-border-subtle text-text-muted hover:text-accent hover:border-accent/50 transition-all bg-transparent cursor-pointer">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
              Exportar progreso
            </button>
            <label class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border border-border-subtle text-text-muted hover:text-accent hover:border-accent/50 transition-all cursor-pointer">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              Importar
              <input type="file" data-import accept="application/json,.json" class="sr-only" />
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Toggle vista + título -->
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <h2 class="text-lg sm:text-xl font-bold text-text">Contenido</h2>
        <div class="flex-1 section-divider hidden sm:block" />
      </div>
      <div class="flex items-center gap-1 p-1 rounded-lg bg-elevated border border-border-subtle">
        <button id="view-list" class="view-btn flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium transition-all bg-accent-soft text-accent border-0 cursor-pointer" data-view="list">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" /></svg>
          Lista
        </button>
        <button id="view-grid" class="view-btn flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium transition-all text-text-muted hover:text-text border-0 cursor-pointer" data-view="grid">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" /></svg>
          Cuadrícula
        </button>
      </div>
    </div>

    <!-- Listado único: la vista lista/cuadrícula cambia por CSS (data-view) -->
    <div id="class-list" data-view="list" data-course-id={courseId} class="cv-list">
      {units.map((unit) => (
        <details class="unit-group mb-4" open data-unit>
          <summary class="flex items-center gap-3 px-1 py-2 text-sm font-bold text-text cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            <span>{unit.name}</span>
            <span class="text-xs font-medium text-text-muted tabular-nums" data-unit-count>{unit.items.length} clases</span>
          </summary>
          <div class="cv-items">
            {unit.items.map((entry) => {
              const n = sortedClasses.findIndex((c) => c.id === entry.id) + 1;
              const ts = typeColors[entry.data.classType] || typeColors.clase;
              const tl = typeLabels[entry.data.classType] || 'Clase';
              return (
                <a
                  href={url(`/cursos/${courseId}/${entry.id}`)}
                  data-class-id={entry.id}
                  class="class-item group"
                >
                  <span class={`ci-num shrink-0 rounded-xl border ${ts} items-center justify-center font-bold`} data-num={n}>{n}</span>
                  <span class="ci-body flex-1 min-w-0">
                    <span class="ci-title">{entry.data.title}</span>
                    {entry.data.description && (
                      <span class="ci-desc">{entry.data.description}</span>
                    )}
                  </span>
                  <span class="ci-badge shrink-0 font-medium rounded-md border bg-white/5 text-text-muted border-border-subtle">{tl}</span>
                  <svg class="ci-arrow shrink-0 text-accent/60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              );
            })}
          </div>
        </details>
      ))}
    </div>

  </div>
  )}

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>

<script define:vars={{ courseId, classCount }}>
  document.addEventListener('DOMContentLoaded', function() {
    var list = document.getElementById('class-list');
    // Stubs archivados no tienen listado.
    if (!list) return;
    var listBtn = document.getElementById('view-list');
    var gridBtn = document.getElementById('view-grid');
    var key = 'ecoudea-progress-' + courseId;

    // ── Vista lista/cuadrícula (un solo render, cambia por CSS) ──────
    function paintViewBtns(view) {
      var on = 'view-btn flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium transition-all bg-accent-soft text-accent border-0 cursor-pointer';
      var off = 'view-btn flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium transition-all text-text-muted hover:text-text border-0 cursor-pointer';
      listBtn.className = view === 'list' ? on : off;
      gridBtn.className = view === 'grid' ? on : off;
    }
    function setView(view, save) {
      list.dataset.view = view;
      paintViewBtns(view);
      if (save !== false) {
        try { localStorage.setItem('ecoudea-course-view', view); } catch (e) {}
      }
    }
    setView(localStorage.getItem('ecoudea-course-view') === 'grid' ? 'grid' : 'list', false);
    listBtn.addEventListener('click', function() { setView('list'); });
    gridBtn.addEventListener('click', function() { setView('grid'); });

    // ── Progreso real (misma llave que el botón ✓ de cada clase) ─────
    function getDone() {
      try { return new Set(JSON.parse(localStorage.getItem(key) || '[]')); }
      catch (e) { return new Set(); }
    }
    function refresh() {
      var done = getDone();
      var items = Array.prototype.slice.call(list.querySelectorAll('[data-class-id]'));
      var n = 0;
      items.forEach(function (a) {
        var ok = done.has(a.dataset.classId);
        if (ok) n++;
        a.classList.toggle('is-done', ok);
        var num = a.querySelector('[data-num]');
        if (num) num.innerHTML = ok
          ? '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>'
          : num.dataset.num;
      });
      var wrap = document.querySelector('[data-progress-wrap]');
      var txt = document.querySelector('[data-progress-text]');
      if (wrap && txt) {
        wrap.classList.remove('hidden');
        wrap.classList.add('inline-flex');
        txt.textContent = n + '/' + classCount;
      }
      document.querySelectorAll('[data-unit]').forEach(function (sec) {
        var ids = Array.prototype.map.call(sec.querySelectorAll('[data-class-id]'), function (a) { return a.dataset.classId; });
        var dn = ids.filter(function (id) { return done.has(id); }).length;
        var c = sec.querySelector('[data-unit-count]');
        if (c) c.textContent = dn + '/' + ids.length + ' completadas';
      });
    }
    refresh();
    window.addEventListener('ecoudea:progress', function (e) {
      if (e.detail && e.detail.courseId === courseId) refresh();
    });
    window.addEventListener('storage', refresh);

    // ── Exportar / importar progreso (JSON, entre dispositivos) ──────
    var expBtn = document.querySelector('[data-export]');
    if (expBtn) expBtn.addEventListener('click', function () {
      var blob = new Blob([JSON.stringify({ course: courseId, done: [...getDone()], exportedAt: new Date().toISOString() }, null, 2)], { type: 'application/json' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'ecoudea-progreso-' + courseId + '.json';
      a.click();
      setTimeout(function () { URL.revokeObjectURL(a.href); }, 2000);
    });
    var impInput = document.querySelector('[data-import]');
    if (impInput) impInput.addEventListener('change', function () {
      var f = impInput.files && impInput.files[0];
      if (!f) return;
      var r = new FileReader();
      r.onload = function () {
        try {
          var data = JSON.parse(r.result);
          var arr = Array.isArray(data) ? data : data.done;
          if (!Array.isArray(arr)) throw new Error('formato');
          var done = getDone();
          arr.forEach(function (id) { if (typeof id === 'string') done.add(id); });
          localStorage.setItem(key, JSON.stringify([...done]));
          refresh();
        } catch (e) {
          alert('Archivo inválido: se esperaba el JSON exportado desde esta página.');
        }
        impInput.value = '';
      };
      r.readAsText(f);
    });
  });
</script>
