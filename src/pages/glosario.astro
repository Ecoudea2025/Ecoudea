---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import glosario from '../lib/glosario.json';
import { url } from '../lib/url';

const entries = Object.entries(glosario);
const letters = [...new Set(entries.map(([, t]) => (t.label[0] || '#').toUpperCase()))].sort();
---

<BaseLayout title="Glosario - Ecoudea" description="Índice de conceptos de economía y estadística explicados en las clases de Ecoudea">
  <Fragment slot="header">
    <Navbar currentPath={url(`/glosario`)} />
  </Fragment>

  <Section width="narrow">
    <SectionHeader
      eyebrow="Referencia"
      title="Glosario"
      lead="Cada término enlaza a las clases donde se explica. El índice se genera solo desde el contenido publicado."
    />

    {entries.length === 0 ? (
      <p class="text-text-muted text-center py-10">Aún no hay términos. Marca conceptos con <code class="font-mono text-sm">&lt;Term id="…"&gt;</code> o añade <code class="font-mono text-sm">conceptos:</code> al frontmatter.</p>
    ) : (
      <>
        <nav aria-label="Por letra inicial" class="flex flex-wrap gap-2 mb-10">
          {letters.map((l) => (
            <a href={`#letra-${l}`} class="w-10 h-10 flex items-center justify-center rounded-lg border border-border-subtle text-sm font-bold text-text-muted hover:text-accent hover:border-accent/50 transition-all no-underline">{l}</a>
          ))}
        </nav>
        {letters.map((l) => (
          <div class="mb-8">
            <h2 id={`letra-${l}`} class="text-xl font-bold gradient-text-alt mb-3" style="scroll-margin-top: 5rem">{l}</h2>
            <dl class="divide-y divide-border-subtle border-y border-border-subtle m-0 p-0">
              {entries.filter(([, t]) => (t.label[0] || '#').toUpperCase() === l).map(([id, t]) => (
                <div id={`term-${id}`} class="py-3 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4" style="scroll-margin-top: 5rem">
                  <dt class="text-sm font-bold text-text shrink-0 sm:w-48">{t.label}</dt>
                  <dd class="text-xs text-text-muted m-0">
                    {t.refs.map((r, i) => (
                      <>
                        {i > 0 && <span aria-hidden="true"> · </span>}
                        <a href={url(`/cursos/${r.course}/${r.class}`)} class="text-accent hover:underline no-underline">{r.classTitle}</a>
                      </>
                    ))}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </>
    )}
  </Section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
