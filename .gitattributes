# Normaliza finales de línea: todo texto con LF (elimina warnings CRLF)
* text=auto eol=lf

# Archivos que requieren exactamente LF (shells/scripts)
*.mjs text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.astro text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binarios: nunca tocar
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.avif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary

# Generado / dependencias: no normalizar ni gestionar
node_modules/
dist/
